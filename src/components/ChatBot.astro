---
// ChatBot – ONE 2 BUY Kiel – OpenAI GPT-4o-mini via /api/chat
---

<div id="o2b-chat">
  <button id="o2b-toggle" aria-label="Chat öffnen">
    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
    </svg>
  </button>

  <div id="o2b-win" role="dialog" aria-label="ONE 2 BUY Chat-Assistent" aria-hidden="true">
    <div id="o2b-head">
      <div class="o2b-head-info">
        <span class="o2b-dot"></span>
        <div>
          <div class="o2b-head-title">ONE 2 BUY Assistent</div>
          <div class="o2b-head-sub">Ankauf &amp; Verkauf Kiel</div>
        </div>
      </div>
      <button id="o2b-close" aria-label="Chat schließen">✕</button>
    </div>

    <div id="o2b-consent">
      <div class="o2b-consent-box">
        <div class="o2b-consent-icon">🔒</div>
        <p class="o2b-consent-title">Datenschutzhinweis</p>
        <p class="o2b-consent-text">
          Dieser Chat nutzt KI-Technologie von OpenAI (USA). Ihre Nachrichten werden zur
          Beantwortung verarbeitet und nicht dauerhaft gespeichert. Mit „Chat starten"
          stimmen Sie der Verarbeitung zu.
        </p>
        <button id="o2b-accept">Chat starten</button>
      </div>
    </div>

    <div id="o2b-msgs" aria-live="polite" aria-relevant="additions"></div>

    <div id="o2b-foot">
      <input
        id="o2b-inp"
        type="text"
        placeholder="Ihre Frage…"
        maxlength="500"
        autocomplete="off"
        aria-label="Nachricht eingeben"
      />
      <button id="o2b-send" aria-label="Senden">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  #o2b-chat {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  #o2b-toggle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #003087;
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 48, 135, 0.45);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  #o2b-toggle:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 22px rgba(0, 48, 135, 0.55);
  }

  /* Window */
  #o2b-win {
    display: none;
    position: absolute;
    bottom: 72px;
    right: 0;
    width: 360px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
    overflow: hidden;
    flex-direction: column;
    max-height: 540px;
  }

  #o2b-win.o2b-open {
    display: flex;
  }

  /* Header */
  #o2b-head {
    background: #003087;
    color: #fff;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .o2b-head-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .o2b-dot {
    width: 10px;
    height: 10px;
    background: #4ade80;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.3);
  }

  .o2b-head-title {
    font-weight: 700;
    font-size: 15px;
  }

  .o2b-head-sub {
    font-size: 11px;
    opacity: 0.75;
  }

  #o2b-close {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
    padding: 4px 6px;
    opacity: 0.75;
    transition: opacity 0.15s;
  }

  #o2b-close:hover {
    opacity: 1;
  }

  /* Consent */
  #o2b-consent {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 20px;
    flex: 1;
  }

  .o2b-consent-box {
    text-align: center;
  }

  .o2b-consent-icon {
    font-size: 34px;
    margin-bottom: 12px;
  }

  .o2b-consent-title {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
    color: #111827;
  }

  .o2b-consent-text {
    margin: 0 0 16px;
    font-size: 13px;
    color: #4b5563;
    line-height: 1.55;
  }

  #o2b-accept {
    background: #003087;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
  }

  #o2b-accept:hover {
    background: #002060;
  }

  /* Messages */
  #o2b-msgs {
    display: none;
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px;
    min-height: 220px;
    max-height: 360px;
    scroll-behavior: smooth;
  }

  .o2b-msg {
    display: flex;
    margin-bottom: 10px;
    animation: o2b-in 0.2s ease;
  }

  @keyframes o2b-in {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .o2b-msg.user  { justify-content: flex-end; }
  .o2b-msg.bot   { justify-content: flex-start; }

  .o2b-bubble {
    max-width: 82%;
    padding: 9px 13px;
    border-radius: 14px;
    font-size: 13.5px;
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.5;
  }

  .o2b-msg.user .o2b-bubble {
    background: #003087;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .o2b-msg.bot .o2b-bubble {
    background: #f3f4f6;
    color: #1f2937;
    border-bottom-left-radius: 4px;
  }

  /* Typing indicator */
  .o2b-typing {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 4px 2px;
  }

  .o2b-typing span {
    width: 7px;
    height: 7px;
    background: #9ca3af;
    border-radius: 50%;
    animation: o2b-bounce 1.1s infinite;
  }

  .o2b-typing span:nth-child(2) { animation-delay: 0.18s; }
  .o2b-typing span:nth-child(3) { animation-delay: 0.36s; }

  @keyframes o2b-bounce {
    0%, 60%, 100% { transform: translateY(0); }
    30%           { transform: translateY(-6px); }
  }

  /* Footer / input */
  #o2b-foot {
    display: none;
    border-top: 1px solid #e5e7eb;
    padding: 10px 12px;
    gap: 8px;
    align-items: center;
    flex-shrink: 0;
  }

  #o2b-inp {
    flex: 1;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.15s;
    min-width: 0;
  }

  #o2b-inp:focus {
    border-color: #003087;
  }

  #o2b-send {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: #003087;
    color: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  #o2b-send:hover:not(:disabled) {
    background: #002060;
  }

  #o2b-send:disabled {
    background: #9ca3af;
    cursor: not-allowed;
  }

  @media (max-width: 420px) {
    #o2b-win {
      width: calc(100vw - 32px);
    }
    #o2b-chat {
      right: 16px;
      bottom: 16px;
    }
  }
</style>

<script>
  const toggle  = document.getElementById('o2b-toggle')!;
  const win     = document.getElementById('o2b-win')!;
  const closeBtn= document.getElementById('o2b-close')!;
  const consent = document.getElementById('o2b-consent')!;
  const acceptBtn= document.getElementById('o2b-accept')!;
  const msgs    = document.getElementById('o2b-msgs')!;
  const foot    = document.getElementById('o2b-foot')!;
  const inp     = document.getElementById('o2b-inp') as HTMLInputElement;
  const sendBtn = document.getElementById('o2b-send') as HTMLButtonElement;

  const WELCOME = 'Hallo! Ich bin der ONE 2 BUY Assistent. Wie kann ich Ihnen helfen? Ich beantworte gerne Fragen zum Ankauf, zu unseren Öffnungszeiten und zu unserem Standort in Kiel.';

  let isOpen = false;
  let history: { role: string; content: string }[] = [];
  let consented = sessionStorage.getItem('o2b-consent') === '1';

  function openChat() {
    isOpen = true;
    win.classList.add('o2b-open');
    win.setAttribute('aria-hidden', 'false');
    if (consented) inp.focus();
  }

  function closeChat() {
    isOpen = false;
    win.classList.remove('o2b-open');
    win.setAttribute('aria-hidden', 'true');
  }

  toggle.addEventListener('click', () => (isOpen ? closeChat() : openChat()));
  closeBtn.addEventListener('click', closeChat);

  acceptBtn.addEventListener('click', () => {
    sessionStorage.setItem('o2b-consent', '1');
    consented = true;
    consent.style.display = 'none';
    msgs.style.display = 'block';
    foot.style.display = 'flex';
    appendBot(WELCOME);
    inp.focus();
  });

  sendBtn.addEventListener('click', send);
  inp.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });

  function appendMsg(role: 'user' | 'bot', text: string) {
    const row    = document.createElement('div');
    row.className = `o2b-msg ${role}`;
    const bubble = document.createElement('div');
    bubble.className = 'o2b-bubble';
    bubble.textContent = text;
    row.appendChild(bubble);
    msgs.appendChild(row);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function appendBot(text: string) {
    history.push({ role: 'assistant', content: text });
    appendMsg('bot', text);
  }

  function showTyping() {
    const row = document.createElement('div');
    row.id = 'o2b-typing-row';
    row.className = 'o2b-msg bot';
    row.innerHTML = '<div class="o2b-bubble"><div class="o2b-typing"><span></span><span></span><span></span></div></div>';
    msgs.appendChild(row);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function hideTyping() {
    document.getElementById('o2b-typing-row')?.remove();
  }

  async function send() {
    const text = inp.value.trim();
    if (!text || sendBtn.disabled) return;

    inp.value = '';
    sendBtn.disabled = true;
    history.push({ role: 'user', content: text });
    appendMsg('user', text);
    showTyping();

    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history }),
      });
      hideTyping();

      if (!res.ok) {
        const err = await res.json().catch(() => ({})) as any;
        appendBot(err.error || 'Fehler aufgetreten. Bitte ruf uns an: 0431 6004839');
      } else {
        const data = await res.json() as any;
        appendBot(data.reply);
      }
    } catch {
      hideTyping();
      appendBot('Verbindungsfehler. Bitte ruf uns an: 0431 6004839');
    }

    sendBtn.disabled = false;
    inp.focus();
  }

  // Restore state if user already consented in this session
  if (consented) {
    consent.style.display = 'none';
    msgs.style.display = 'block';
    foot.style.display = 'flex';
    appendBot(WELCOME);
  }
</script>

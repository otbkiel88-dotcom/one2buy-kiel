---
import { SITE } from '../config/site';
const currentPath = Astro.url.pathname;
---

<header class="bg-brand-blue text-white shadow-lg sticky top-0 z-50">
  <!-- Top info bar (desktop only) -->
  <div class="bg-brand-blue-dark text-sm hidden md:block">
    <div class="max-w-7xl mx-auto px-4 py-1.5 flex justify-between items-center">
      <span>Kiels größter An- &amp; Verkauf seit 1999</span>
      <div class="flex gap-6">
        <a href={SITE.shop.phoneHref} class="hover:text-yellow-300 transition-colors">
          📞 {SITE.shop.phone}
        </a>
        <a href={SITE.shop.emailHref} class="hover:text-yellow-300 transition-colors">
          ✉ {SITE.shop.email}
        </a>
        <span>Mo–Fr 9–19 | Sa 10–18</span>
      </div>
    </div>
  </div>

  <!-- Main nav bar -->
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 hover:opacity-90 transition-opacity" aria-label="ONE 2 BUY Kiel – Startseite">
        <img
          src="/logo.png"
          alt="ONE 2 BUY Kiel"
          class="h-9 w-auto md:h-14 object-contain"
        />
        <span class="font-black text-lg md:text-2xl tracking-tight text-white">
          ONE <span class="text-brand-red">2</span> BUY
        </span>
      </a>

      <!-- Desktop nav (lg and above) -->
      <nav class="hidden lg:flex items-center gap-1">
        {SITE.nav.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors hover:bg-brand-blue-light ${
              currentPath === item.href ? 'bg-brand-blue-light' : ''
            }`}
          >
            {item.label}
          </a>
        ))}
        <a
          href={SITE.ebay.storeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 px-4 py-2 bg-brand-red hover:bg-brand-red-dark rounded-md text-sm font-bold transition-colors"
        >
          eBay Shop
        </a>
      </nav>

      <!-- Hamburger button (below lg) -->
      <button
        id="menu-btn"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden flex flex-col justify-center gap-1.5 w-10 h-10 p-2 rounded-md hover:bg-brand-blue-light transition-colors"
      >
        <span id="bar1" class="block w-full h-0.5 bg-white rounded-full transition-all duration-300 origin-center"></span>
        <span id="bar2" class="block w-full h-0.5 bg-white rounded-full transition-all duration-300"></span>
        <span id="bar3" class="block w-full h-0.5 bg-white rounded-full transition-all duration-300 origin-center"></span>
      </button>
    </div>

    <!-- Mobile dropdown menu (below lg) -->
    <nav
      id="mobile-menu"
      aria-hidden="true"
      style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;"
      class="lg:hidden"
    >
      <div class="flex flex-col gap-1 pb-4 pt-1 border-t border-brand-blue-light">
        {SITE.nav.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-2.5 rounded-md text-sm font-medium transition-colors hover:bg-brand-blue-light ${
              currentPath === item.href ? 'bg-brand-blue-light' : ''
            }`}
          >
            {item.label}
          </a>
        ))}
        <div class="mt-2 pt-2 border-t border-brand-blue-light flex flex-col gap-2">
          <a
            href={SITE.shop.phoneHref}
            class="px-3 py-2.5 rounded-md text-sm font-semibold text-yellow-300 hover:bg-brand-blue-light transition-colors"
          >
            📞 {SITE.shop.phone}
          </a>
          <a
            href={SITE.ebay.storeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 bg-brand-red hover:bg-brand-red-dark rounded-md text-sm font-bold text-center transition-colors"
          >
            eBay Shop →
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn   = document.getElementById('menu-btn') as HTMLButtonElement;
  const menu  = document.getElementById('mobile-menu') as HTMLElement;
  const bar1  = document.getElementById('bar1') as HTMLElement;
  const bar2  = document.getElementById('bar2') as HTMLElement;
  const bar3  = document.getElementById('bar3') as HTMLElement;

  if (!btn || !menu) throw new Error('Header: menu elements not found');

  let isOpen = false;

  function openMenu() {
    isOpen = true;
    menu.style.maxHeight = menu.scrollHeight + 'px';
    menu.setAttribute('aria-hidden', 'false');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Menü schließen');
    bar1.style.transform = 'translateY(8px) rotate(45deg)';
    bar2.style.opacity = '0';
    bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
  }

  function closeMenu() {
    isOpen = false;
    menu.style.maxHeight = '0';
    menu.setAttribute('aria-hidden', 'true');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Menü öffnen');
    bar1.style.transform = '';
    bar2.style.opacity = '';
    bar3.style.transform = '';
  }

  btn.addEventListener('click', () => (isOpen ? closeMenu() : openMenu()));

  // Close when any mobile nav link is clicked
  menu.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Close when clicking outside the header
  document.addEventListener('click', (e) => {
    if (isOpen && !btn.closest('header')?.contains(e.target as Node)) {
      closeMenu();
    }
  });
</script>

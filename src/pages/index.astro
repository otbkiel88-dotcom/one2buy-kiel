---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Startseite"
  description="ONE 2 BUY Kiel – Kiels größter An- & Verkauf seit 1999. Wir kaufen Smartphones, Elektronik, Konsolen, Spiele, Werkzeug sowie Gold & Silber. Faire Preise, sofortige Auszahlung."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-blue to-brand-blue-light text-white py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-4">
        ONE <span class="text-brand-red">2</span> BUY <span class="text-yellow-300">Kiel</span>
      </h1>
      <p class="text-xl md:text-2xl font-light text-blue-100 mb-2">
        Kiels größter First-Class An- &amp; Verkauf
      </p>
      <p class="text-blue-200 mb-8">Seit 1999 – Faire Preise. Schnelle Abwicklung. Garantiert.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/ankauf" class="px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white font-bold text-lg rounded-lg transition-colors shadow-lg">
          Jetzt verkaufen →
        </a>
        <a href="/verkauf" class="px-8 py-4 bg-white text-brand-blue hover:bg-blue-50 font-bold text-lg rounded-lg transition-colors shadow-lg">
          Angebote ansehen
        </a>
      </div>
    </div>
  </section>

  <!-- Info-Banner -->
  <section class="bg-brand-red text-white py-4">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-center gap-6 text-sm font-medium text-center">
      <span>📍 {SITE.shop.address}, {SITE.shop.zip} {SITE.shop.city}</span>
      <span class="hidden sm:block text-red-300">|</span>
      <a href={SITE.shop.phoneHref} class="hover:underline">📞 {SITE.shop.phone}</a>
      <span class="hidden sm:block text-red-300">|</span>
      <span>Mo–Fr 9–19 · Sa 10–18</span>
    </div>
  </section>

  <!-- Kategorien Ankauf -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black text-center text-brand-blue mb-2">Wir kaufen an</h2>
      <p class="text-center text-gray-500 mb-10">Sofortige Auszahlung – Keine Wartezeit</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
        {[
          { icon: '📱', title: 'Smartphones' },
          { icon: '🎮', title: 'Konsolen & Spiele' },
          { icon: '💻', title: 'Multimedia' },
          { icon: '🔧', title: 'Werkzeug' },
          { icon: '🥇', title: 'Gold & Silber' },
        ].map((cat) => (
          <a href="/ankauf" class="group bg-white rounded-xl p-6 text-center shadow-sm hover:shadow-md hover:border-brand-blue border border-transparent transition-all">
            <div class="text-4xl mb-3">{cat.icon}</div>
            <div class="font-semibold text-gray-800 group-hover:text-brand-blue transition-colors">{cat.title}</div>
          </a>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/ankauf" class="inline-block px-8 py-3 bg-brand-blue hover:bg-brand-blue-light text-white font-bold rounded-lg transition-colors">
          Mehr erfahren →
        </a>
      </div>
    </div>
  </section>

  <!-- Warum ONE 2 BUY -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black text-center text-brand-blue mb-10">Warum ONE 2 BUY?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { icon: '💰', title: 'Faire Preise', text: 'Wir zahlen Top-Preise für Ihre Geräte. Kein Feilschen, kein Verstecken – transparent und fair.' },
          { icon: '⚡', title: 'Sofortauszahlung', text: 'Sie kommen rein, wir schauen an, Sie gehen mit Bargeld raus. So einfach ist das.' },
          { icon: '⭐', title: 'Seit 1999', text: 'Über 25 Jahre Erfahrung in Kiel. First-Class-Service ist bei uns nicht nur ein Versprechen.' },
        ].map((item) => (
          <div class="text-center p-6 rounded-xl bg-gray-50">
            <div class="text-5xl mb-4">{item.icon}</div>
            <h3 class="text-xl font-bold text-brand-blue mb-3">{item.title}</h3>
            <p class="text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Aktuelle eBay Angebote -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black text-center text-brand-blue mb-2">Aktuelle Angebote</h2>
      <p class="text-center text-gray-500 mb-8">Direkt aus unserem eBay-Shop</p>
      <div class="text-center">
        <a
          href={SITE.ebay.storeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white font-bold text-lg rounded-lg transition-colors"
        >
          Alle Angebote auf eBay ansehen →
        </a>
        <p class="mt-3 text-sm text-gray-500">
          oder <a href="/verkauf" class="text-brand-blue hover:underline">Angebote auf unserer Website</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Standort & Karte -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black text-center text-brand-blue mb-10">Unser Standort</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <div class="bg-brand-blue text-white rounded-xl p-8">
            <h3 class="text-2xl font-bold mb-6">ONE 2 BUY Kiel</h3>
            <div class="space-y-4 text-blue-100">
              <p class="flex gap-3"><span>📍</span><span>{SITE.shop.address}<br />{SITE.shop.zip} {SITE.shop.city}</span></p>
              <p class="flex gap-3"><span>📞</span><a href={SITE.shop.phoneHref} class="hover:text-white transition-colors">{SITE.shop.phone}</a></p>
              <p class="flex gap-3"><span>✉</span><a href={SITE.shop.emailHref} class="hover:text-white transition-colors">{SITE.shop.email}</a></p>
            </div>
            <div class="mt-6 pt-6 border-t border-brand-blue-light">
              <h4 class="font-semibold text-yellow-300 mb-3">Öffnungszeiten</h4>
              <div class="space-y-2 text-sm">
                {SITE.hours.map((h) => (
                  <div class="flex justify-between">
                    <span class="text-blue-200">{h.days}</span>
                    <span class={h.closed ? 'text-red-400' : 'text-white font-medium'}>{h.time}</span>
                  </div>
                ))}
              </div>
            </div>
            <a
              href={SITE.shop.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-6 px-6 py-2 bg-white text-brand-blue hover:bg-blue-50 font-bold rounded-lg transition-colors"
            >
              Route planen →
            </a>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden shadow-lg h-80">
          <iframe
            src={SITE.shop.mapsEmbed}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="ONE 2 BUY Kiel auf Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="bg-brand-blue-dark text-white py-12">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl md:text-3xl font-black mb-4">Haben Sie etwas zu verkaufen?</h2>
      <p class="text-blue-200 mb-6">Kommen Sie einfach vorbei oder rufen Sie uns an. Wir bewerten kostenlos und zahlen sofort bar.</p>
      <a href={SITE.shop.phoneHref} class="inline-block px-8 py-4 bg-brand-red hover:bg-brand-red-dark text-white font-bold text-lg rounded-lg transition-colors">
        Jetzt anrufen: {SITE.shop.phone}
      </a>
    </div>
  </section>
</BaseLayout>

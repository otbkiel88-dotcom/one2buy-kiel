---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const categories = [
  {
    icon: '📱',
    title: 'Smartphones & Handys',
    items: ['Apple iPhone', 'Samsung Galaxy', 'Huawei', 'OnePlus', 'Xiaomi', 'Alle anderen Marken'],
  },
  {
    icon: '🎮',
    title: 'Spielekonsolen & Spiele',
    items: ['PlayStation 3, 4, 5', 'Xbox 360, One, Series X/S', 'Nintendo Switch, Wii, DS', 'Games & Controller'],
  },
  {
    icon: '💻',
    title: 'Multimedia & Elektronik',
    items: ['Laptops & Tablets', 'Kameras & Zubehör', 'Smart-TVs', 'Lautsprecher & Kopfhörer', 'DVD/Blu-ray Player'],
  },
  {
    icon: '🔧',
    title: 'Werkzeug',
    items: ['Bohrmaschinen', 'Akkuschrauber', 'Winkelschleifer', 'Handwerkzeug', 'Gartengeräte'],
  },
  {
    icon: '🥇',
    title: 'Gold & Silber',
    items: ['Goldschmuck', 'Silberschmuck', 'Münzen', 'Zahngold', 'Bruchgold'],
  },
];
---

<BaseLayout
  title="Ankauf"
  description="ONE 2 BUY Kiel kauft Smartphones, Elektronik, Konsolen, Spiele, Werkzeug sowie Gold & Silber. Faire Preise, sofortige Barzahlung. Kommen Sie einfach vorbei!"
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-brand-blue to-brand-blue-light text-white py-14 md:py-20">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-black mb-4">Wir kaufen an</h1>
      <p class="text-xl text-blue-100 mb-6">Faire Preise · Sofortige Barzahlung · Keine Wartezeit</p>
      <a href={SITE.shop.phoneHref} class="inline-block px-8 py-4 bg-brand-red hover:bg-brand-red-dark font-bold text-lg rounded-lg transition-colors">
        📞 Jetzt anrufen: {SITE.shop.phone}
      </a>
    </div>
  </section>

  <!-- So funktioniert es -->
  <section class="py-14 bg-white">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black text-center text-brand-blue mb-10">So einfach geht's</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { step: '1', icon: '🚪', title: 'Einfach vorbeikommen', text: 'Bringen Sie Ihre Artikel zu uns ins Geschäft – kein Termin nötig.' },
          { step: '2', icon: '🔍', title: 'Kostenlose Bewertung', text: 'Wir schauen uns alles an und machen Ihnen sofort ein faires Angebot.' },
          { step: '3', icon: '💵', title: 'Sofort Bargeld', text: 'Sie stimmen zu – wir zahlen bar. Fertig. Keine Wartezeit.' },
        ].map((step) => (
          <div class="text-center p-8 bg-gray-50 rounded-xl relative">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 bg-brand-red text-white rounded-full flex items-center justify-center font-black text-sm">
              {step.step}
            </div>
            <div class="text-5xl mb-4 mt-2">{step.icon}</div>
            <h3 class="text-lg font-bold text-brand-blue mb-3">{step.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kategorien -->
  <section class="py-14 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="text-3xl font-black text-center text-brand-blue mb-10">Was wir ankaufen</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <div class="text-4xl mb-3">{cat.icon}</div>
            <h3 class="text-xl font-bold text-brand-blue mb-4">{cat.title}</h3>
            <ul class="space-y-2">
              {cat.items.map((item) => (
                <li class="flex items-center gap-2 text-gray-600 text-sm">
                  <span class="text-brand-red font-bold">✓</span> {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Goldankauf CTA -->
  <section class="py-10 bg-yellow-50 border-y border-yellow-200">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-2xl font-black text-brand-blue mb-3">Gold & Silber ankaufen</h2>
      <p class="text-gray-600 mb-5 leading-relaxed">Wir zahlen faire Marktpreise für Gold, Silber, Schmuck und Münzen.</p>
      <a href="/goldankauf" class="inline-block px-6 py-3 bg-brand-blue hover:bg-brand-blue-light text-white font-bold rounded-lg transition-colors">
        Mehr zum Goldankauf →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-14 bg-brand-blue text-white">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-black mb-4">Bereit zu verkaufen?</h2>
      <p class="text-blue-200 mb-6 leading-relaxed">Kommen Sie einfach zu uns — wir sind Mo–Fr 9–19 Uhr und Sa 10–18 Uhr für Sie da.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={SITE.shop.phoneHref} class="px-8 py-3 bg-brand-red hover:bg-brand-red-dark font-bold rounded-lg transition-colors">
          📞 {SITE.shop.phone}
        </a>
        <a href="/standorte" class="px-8 py-3 bg-white text-brand-blue hover:bg-blue-50 font-bold rounded-lg transition-colors">
          📍 Zum Standort
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
